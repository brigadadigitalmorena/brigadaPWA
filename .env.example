# API Configuration
# Browser requests use the same-origin proxy at /api/backend (no CORS issues).
# API_URL is used server-side by the Next.js proxy (set this in Vercel).
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TIMEOUT=30000

# App Configuration
NEXT_PUBLIC_APP_NAME=Brigada Digital
NEXT_PUBLIC_APP_VERSION=1.0.0

# Optional observability. Leave empty to disable.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Web Push (VAPID public key). Leave empty to skip registration.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Enable only when testing offline behavior locally; stale SWs can confuse dev.
NEXT_PUBLIC_ENABLE_SW_DEV=false
